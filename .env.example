# --- Postgres (local via docker compose) ---
POSTGRES_DB=lingstepa
POSTGRES_USER=lingstepa
POSTGRES_PASSWORD=lingstepa
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=18080
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/lingstepa
SPRING_DATASOURCE_USERNAME=lingstepa
SPRING_DATASOURCE_PASSWORD=lingstepa
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_AUTH_OAUTH_ENABLED=false
APP_AUTH_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/
APP_AUTH_OAUTH_FAILURE_REDIRECT_URI=http://localhost:5173/login?oauth=failed
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# --- Frontend ---
FRONTEND_PORT=5173
# Nginx 경유(기본): 비워두면 프론트가 /api 상대경로 사용
# VITE_API_BASE_URL=
# 프론트 직접 접속 시에만 아래처럼 백엔드 주소 설정
VITE_API_BASE_URL=http://localhost:18080
VITE_GOOGLE_OAUTH_ENABLED=false
